{
  "Logging": {
   
    "ApplicationName": "TodoApi",
 
    "LogFilePath": "logs/todo-.log",

    "RetainedFileCountLimit": 7,

    "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",

    "ConsoleOutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",

    "LevelOverrides": {
      "Microsoft": "Warning",
      "MicrosoftAspNetCore": "Warning",
      "MicrosoftEntityFrameworkCore": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings" : {
    "DbConnection" : "Host=localhost; Password=aggrey909; Port=5433; database=TodoDb; User Id=postgres",
    "Redis" : "localhost:6379"
  },
  "JwtSettings": {
    "Key": "YourSuperSecretKeyForJWTTokenGenerationThatShouldBeAtLeast32CharactersLong",
    "Issuer": "TodoApi",
    "Audience": "TodoApiUsers",
    "ExpirationInMinutes": 60
  }
}
