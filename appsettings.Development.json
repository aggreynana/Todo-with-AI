{
  "Logging": {
    // Application name that appears in log entries for identification
    "ApplicationName": "TodoApi",
    // Development-specific log file path with "-dev-" suffix to distinguish from production logs
    "LogFilePath": "logs/todo-dev-.log",
    // Fewer log files retained in development (3 days vs 7 in production)
    "RetainedFileCountLimit": 3,
    // Output template for file logs with full timestamp and timezone information
    "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
    // Simplified output template for console logs (more concise for development)
    "ConsoleOutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
    // Development uses Information level for framework logs to see more detailed output
    "LevelOverrides": {
      "Microsoft": "Information",
      "MicrosoftAspNetCore": "Information",
      "MicrosoftEntityFrameworkCore": "Information",
      "System": "Information"
    }
  },
  "ConnectionStrings": {
    // Redis connection string for development environment (using Docker service name)
    "Redis": "redis:6379"
  }
}
