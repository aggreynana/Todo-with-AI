{
  "Logging": {
    // Application name that appears in log entries for identification
    "ApplicationName": "TodoApi",
    // File path for log output with daily rolling (the "-" creates date-based filenames)
    "LogFilePath": "logs/todo-.log",
    // Number of log files to retain before automatic cleanup (7 days)
    "RetainedFileCountLimit": 7,
    // Output template for file logs with full timestamp and timezone information
    "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
    // Simplified output template for console logs (more concise for development)
    "ConsoleOutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
    // Log level overrides to reduce noise from framework components
    "LevelOverrides": {
      "Microsoft": "Warning",
      "MicrosoftAspNetCore": "Warning",
      "MicrosoftEntityFrameworkCore": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings" : {
    "DbConnection" : "Host=localhost; Password=aggrey909; Port=5432; database=TodoDb; User Id=postgres",
    "Redis" : "localhost:6379"
  },
  "JwtSettings": {
    "Key": "YourSuperSecretKeyForJWTTokenGenerationThatShouldBeAtLeast32CharactersLong",
    "Issuer": "TodoApi",
    "Audience": "TodoApiUsers",
    "ExpirationInMinutes": 60
  }
}
